{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["ir_version", "requirements", "entities", "conflicts", "missing_items"],
  "properties": {
    "ir_version": {"const": "1.0"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "type", "status", "source", "confidence"],
        "properties": {
          "id": {"type": "string"}, "text": {"type": "string", "minLength": 1},
          "type": {"type": "string"}, "status": {"type": "string"},
          "source": {"type": "object", "required": ["artifact_id", "location"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": true
      }
    },
    "entities": {"type": "object"},
    "conflicts": {"type": "array"},
    "missing_items": {"type": "array"}
  },
  "additionalProperties": true
}
